# Forge web client environment.
# Copy to `.env.local` and fill in. Values map to the Terraform `client_configuration` output.

# Base URL of the backend API.
#  - Local dev:    http://localhost:3001  (run npm run backend:dev)
#  - Deployed:     https://<api-id>.execute-api.<region>.amazonaws.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# When true, the app skips Cognito sign-in and talks to the backend unauthenticated.
# The local dev server resolves identity from FORGE_TEST_USER_ID, so leave this true
# for local development. Set to false to exercise the real Cognito Hosted UI flow.
NEXT_PUBLIC_AUTH_DISABLED=true

# --- Cognito (only needed when NEXT_PUBLIC_AUTH_DISABLED=false) ---
# From `terraform output client_configuration`.
NEXT_PUBLIC_COGNITO_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Hosted UI base, e.g. https://forge-dev-123456789012.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_HOSTED_UI_DOMAIN=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_COGNITO_LOGOUT_URI=http://localhost:3000/
