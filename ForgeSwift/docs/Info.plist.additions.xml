<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    INFO.PLIST ADDITIONS FOR VOICE COACH
    
    Add these keys to your existing Info.plist file.
    DO NOT replace your entire Info.plist — just add these entries.
-->
<plist version="1.0">
<dict>
    <!-- Microphone Permission -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Forge uses your microphone to let you talk to your AI coach hands-free during workouts.</string>
    
    <!-- Speech Recognition Permission -->
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Forge uses speech recognition so you can ask your AI coach questions without touching your phone.</string>
    
    <!-- Anthropic API Key (DEVELOPMENT ONLY) -->
    <key>ANTHROPIC_API_KEY</key>
    <string>YOUR_ANTHROPIC_API_KEY_HERE</string>
    
    <!--
        ⚠️ SECURITY WARNING ⚠️
        
        Storing API keys in Info.plist is acceptable for development and testing,
        but NOT recommended for production apps that you ship to the App Store.
        
        For production, use one of these approaches:
        
        1. Backend Proxy (RECOMMENDED)
           - Create your own backend API that calls Claude
           - Your app calls your backend
           - API key stays on your server
        
        2. Keychain Storage
           - Store key in iOS Keychain
           - Inject key at runtime, not compile time
           - Use obfuscation techniques
        
        3. Environment Variables
           - Use Xcode build configurations
           - Different keys for Debug/Release
           - Never commit keys to git
        
        4. Firebase Remote Config / AWS Secrets Manager
           - Store encrypted keys remotely
           - Fetch at runtime with authentication
        
        Example production setup:
        
        // VoiceCoachManager.swift
        private let apiKey: String = {
            if let key = KeychainHelper.shared.getAPIKey() {
                return key
            }
            // Fallback to server-side proxy
            return "" // Your app calls your backend instead
        }()
        
        Add to .gitignore:
        *.xcconfig
        Config.plist
        Secrets.swift
    -->
</dict>
</plist>
