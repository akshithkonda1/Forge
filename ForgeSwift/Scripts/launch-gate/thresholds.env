# Launch stability gate thresholds — the ONLY place these numbers live.
# Read by launch_gate.py (and echoed into the job summary). Change a number
# here in a reviewed PR; never loosen one inline in the workflow.

# (1) Cold launch: a non-blank frame (splash or AuthWelcome) must be on screen
# within this many seconds of `simctl launch`. A uniform screenshot = blank.
FIRST_FRAME_MAX_S=8
# A screenshot is "blank" when its dominant colour covers >= this share.
BLANK_DOMINANT_SHARE=0.995
# The app's frame must differ from a pre-launch baseline screenshot in at
# least this share of sampled pixels (so the springboard can't pass).
FRAME_DIFF_MIN_SHARE=0.10

# (1) Main-thread hang: over each SAMPLE_WINDOW_S window, the main thread may
# spend at most MAIN_THREAD_BLOCK_MAX_S outside its idle run loop wait.
MAIN_THREAD_BLOCK_MAX_S=2.0
SAMPLE_WINDOW_S=3
# Windows sampled back to back after the first frame.
SAMPLE_WINDOWS=4
# `sample` attempts per window, and per-attempt timeout (s). The first cold
# sample attaches while the process is still loading, so it gets longer.
SAMPLE_RETRIES=2
SAMPLE_TIMEOUT_S=60
SAMPLE_TIMEOUT_COLD_S=150

# (2) Startup memory (phys_footprint, MB). Early = right after first frame;
# steady = MEMORY_STEADY_AT_S after launch.
MEMORY_STEADY_AT_S=30
MEMORY_MAX_MB=450
MEMORY_GROWTH_MAX_MB=80

# (3) Relaunch wedge: with the crash-surviving handoff flag set
# (forge.onboarding.interviewComplete=1, forge.onboarding.completed=0), the app
# must leave AriaForgePrep (flag cleared or onboarding completed) by this time.
PREP_WATCHDOG_S=60

# Process must still be alive at every checkpoint (crash at launch = fail).
