         </BuildableReference>
      </BuildableProductRunnable>
      <!-- Collaborative mode: phone + watch. Post-action opens ForgeWatch on booted watch sims. -->
      <EnvironmentVariables>
         <EnvironmentVariable
            key = "FORGE_LAUNCH_WATCH_COMPANION"
            value = "1"
            isEnabled = "YES">
