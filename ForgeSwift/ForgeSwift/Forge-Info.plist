<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Forge</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.forge.device</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>forge</string>
			</array>
		</dict>
	</array>
	<key>FORGE_API_BASE_URL</key>
	<string>http://127.0.0.1:3001</string>
	<key>FORGE_COGNITO_CLIENT_ID</key>
	<string></string>
	<key>FORGE_COGNITO_REGION</key>
	<string>us-east-1</string>
	<key>FORGE_USE_AUTH</key>
	<string>false</string>
	<key>FORGE_WEB_CALLBACK_BASE_URL</key>
	<string>forge://device-connected</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSHealthShareUsageDescription</key>
	<string>Forge reads your steps, sleep, heart rate, and workouts to personalize training and recovery recommendations.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Forge can log workouts and nutrition to Apple Health so your fitness data stays in one place.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Forge connects to the local development API on your Mac while you are testing the app.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Forge uses your microphone for hands-free voice coaching during workouts.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Forge uses speech recognition so you can talk to your AI coach without touching your phone.</string>
</dict>
</plist>