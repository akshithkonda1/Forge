<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23727" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="forge-launch-vc">
    <device id="retina6_1" orientation="portrait" appearance="dark"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23721"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Launch-->
        <scene sceneID="forge-launch-scene">
            <objects>
                <viewController id="forge-launch-vc" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="forge-launch-view">
                        <rect key="frame" x="0.0" y="0.0" width="414" height="896"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="forge-launch-edge">
                                <rect key="frame" x="127" y="368" width="160" height="160"/>
                                <color key="backgroundColor" red="1" green="1" blue="1" alpha="0.16" colorSpace="custom" customColorSpace="sRGB"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="160" id="forge-launch-edge-w"/>
                                    <constraint firstAttribute="height" constant="160" id="forge-launch-edge-h"/>
                                </constraints>
                            </view>
                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="forge-launch-mark">
                                <rect key="frame" x="135" y="376" width="144" height="144"/>
                                <color key="backgroundColor" red="1" green="0.30196078431372547" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="144" id="forge-launch-mark-w"/>
                                    <constraint firstAttribute="height" constant="144" id="forge-launch-mark-h"/>
                                </constraints>
                            </view>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="forge-launch-safe"/>
                        <color key="backgroundColor" red="0.03137254901960784" green="0.03137254901960784" blue="0.047058823529411764" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="forge-launch-edge" firstAttribute="centerX" secondItem="forge-launch-view" secondAttribute="centerX" id="forge-launch-edge-cx"/>
                            <constraint firstItem="forge-launch-edge" firstAttribute="centerY" secondItem="forge-launch-view" secondAttribute="centerY" id="forge-launch-edge-cy"/>
                            <constraint firstItem="forge-launch-mark" firstAttribute="centerX" secondItem="forge-launch-view" secondAttribute="centerX" id="forge-launch-mark-cx"/>
                            <constraint firstItem="forge-launch-mark" firstAttribute="centerY" secondItem="forge-launch-view" secondAttribute="centerY" id="forge-launch-mark-cy"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="forge-launch-first" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="80" y="80"/>
        </scene>
    </scenes>
</document>
