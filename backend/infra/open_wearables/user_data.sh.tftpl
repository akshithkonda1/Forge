#!/bin/bash
# Open Wearables boot: Docker + compose, seed .env from SSM, start the
# official stack. Official entrypoints run their own DB migrations.
# Rendered by open_wearables.tf (templatefile). HealthKit data is not
# written here.
set -euo pipefail

dnf install -y docker unzip openssl
systemctl enable --now docker

mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose \
  "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-aarch64"
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=1024
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

ssm_get() {
  aws ssm get-parameter --with-decryption --name "${ssm_prefix}/$1" \
    --query Parameter.Value --output text --region "${aws_region}"
}

WEBHOOK_SECRET="$(ssm_get WEBHOOK_SECRET)"
ADMIN_PASSWORD="$(ssm_get ADMIN_PASSWORD)"
POSTGRES_PASSWORD="$(ssm_get POSTGRES_PASSWORD)"
OURA_CLIENT_ID="$(ssm_get oura/client_id)"
OURA_CLIENT_SECRET="$(ssm_get oura/client_secret)"
WHOOP_CLIENT_ID="$(ssm_get whoop/client_id)"
WHOOP_CLIENT_SECRET="$(ssm_get whoop/client_secret)"
GARMIN_CLIENT_ID="$(ssm_get garmin/client_id)"
GARMIN_CLIENT_SECRET="$(ssm_get garmin/client_secret)"
STRAVA_CLIENT_ID="$(ssm_get strava/client_id)"
STRAVA_CLIENT_SECRET="$(ssm_get strava/client_secret)"

DEPLOY=/opt/open-wearables
mkdir -p "$DEPLOY"
umask 077
cat > "$DEPLOY/.env" <<ENV
ENVIRONMENT=${environment}
API_BASE_URL=https://${ow_domain}
FORGE_WEBHOOK_URL=${webhook_url}
WEBHOOK_SECRET=$WEBHOOK_SECRET
ADMIN_PASSWORD=$ADMIN_PASSWORD
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
POSTGRES_USER=openwearables
POSTGRES_DB=openwearables
OURA_CLIENT_ID=$OURA_CLIENT_ID
OURA_CLIENT_SECRET=$OURA_CLIENT_SECRET
WHOOP_CLIENT_ID=$WHOOP_CLIENT_ID
WHOOP_CLIENT_SECRET=$WHOOP_CLIENT_SECRET
GARMIN_CLIENT_ID=$GARMIN_CLIENT_ID
GARMIN_CLIENT_SECRET=$GARMIN_CLIENT_SECRET
STRAVA_CLIENT_ID=$STRAVA_CLIENT_ID
STRAVA_CLIENT_SECRET=$STRAVA_CLIENT_SECRET
TELEMETRY_ENABLED=false
DO_NOT_TRACK=1
ENV

cat > "$DEPLOY/docker-compose.yml" <<COMPOSE
services:
  db:
    image: postgres:18-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: \$${POSTGRES_USER}
      POSTGRES_PASSWORD: \$${POSTGRES_PASSWORD}
      POSTGRES_DB: \$${POSTGRES_DB}
    volumes:
      - postgres-data:/var/lib/postgresql/data
    expose:
      - "5432"
  redis:
    image: redis:8-alpine
    restart: unless-stopped
    command: ["redis-server", "--save", "", "--appendonly", "no"]
    expose:
      - "6379"
  app:
    image: ${backend_image}
    restart: unless-stopped
    env_file: .env
    depends_on: [db, redis]
    expose:
      - "8000"
  worker:
    image: ${backend_image}
    restart: unless-stopped
    command: celery -A app worker -l info
    env_file: .env
    depends_on: [db, redis, app]
  beat:
    image: ${backend_image}
    restart: unless-stopped
    command: celery -A app beat -l info
    env_file: .env
    depends_on: [db, redis, app]
  frontend:
    image: ${frontend_image}
    restart: unless-stopped
    env_file: .env
    depends_on: [app]
    expose:
      - "3000"
  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
    depends_on: [app, frontend]
volumes:
  postgres-data:
  caddy-data:
COMPOSE

cat > "$DEPLOY/Caddyfile" <<CADDY
${ow_domain} {
  encode gzip
  handle /api/* {
    reverse_proxy app:8000
  }
  handle /oauth/* {
    reverse_proxy app:8000
  }
  handle {
    reverse_proxy frontend:3000
  }
}
CADDY

cd "$DEPLOY"
docker compose pull
docker compose up -d
# Official images apply Alembic / Django / equivalent migrations on startup.
# Do not pipe health samples into CloudWatch. Logs stay on the box.
