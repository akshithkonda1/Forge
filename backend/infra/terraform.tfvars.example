aws_region   = "us-east-1"
project_name = "forge"

# Required, no default. Anything outside prod/production/staging/stage leaves the
# unsigned dev-override token accepted and serves seeded demo data in place of a
# user's own health metrics. Set "prod" for anything real people log into.
environment = "dev"

allowed_origins = [
  "http://localhost:3000",
]

# Optional: set this only if you want to override the generated bucket name.
# uploads_bucket_name = "forge-dev-123456789012-us-east-1-uploads"

# Public PKCE clients. iOS is the Forge custom scheme. Web and Kotlin must be
# the exact https callbacks for that environment — these are URLs, not secrets.
# Apple / Google client secrets go in Parameter Store SecureString, never here.
# cognito_web_callback_urls    = ["https://app.example.com/auth/callback"]
# cognito_web_logout_urls      = ["https://app.example.com/auth/logout"]
# cognito_kotlin_callback_urls = ["https://app.example.com/kotlin/auth/callback"]
# cognito_kotlin_logout_urls   = ["https://app.example.com/kotlin/auth/logout"]

# Seed ElevenLabs after apply so the values never land in Terraform state:
#   aws ssm put-parameter --name /forge-dev/ai/ELEVENLABS_API_KEY \
#     --type SecureString --overwrite --value 'replace-me'
# Same for ELEVENLABS_ARIA_VOICE_ID and ELEVENLABS_ARIA_AGENT_ID.
#
# Before the first real apply, also seed the social IdP parameters Terraform
# reads (names only; values stay out of this file):
#   /forge-dev/cognito/google/client_id
#   /forge-dev/cognito/google/client_secret
#   /forge-dev/cognito/apple/client_id
#   /forge-dev/cognito/apple/team_id
#   /forge-dev/cognito/apple/key_id
#   /forge-dev/cognito/apple/private_key

tags = {
  Owner = "Forge"
}

# Keep aria_bedrock_enabled unset (default false). Dummy-offline and
# live-API-no-Bedrock must not turn Bedrock on.
# aria_bedrock_enabled = false
#
# Router slots. Leave unset to keep ai_router.default_models() fallbacks:
#   1 anthropic.claude-sonnet-4-6  / Claude Sonnet 4.6
#   2 anthropic.claude-opus-4-7    / Claude Opus 4.7
#   3 global.xai.grok-4.6          / Grok
# After greenlight, a Claude 5 swap is env/tfvars only (IAM already allows
# anthropic.*). Runtime in us-east-1 wants CRIS ids, not bare foundation ids:
#   us.anthropic.claude-sonnet-5 / us.anthropic.claude-opus-5
#   (or global.anthropic.claude-sonnet-5 / global.anthropic.claude-opus-5)
# US-only Grok residency would be us.xai.grok-4.6. Do not put Grok 4.3 here.
# Set id and name together; a name that disagrees with the id is worse than
# no name.
# ai_router_model_1_id   = "anthropic.claude-sonnet-4-6"
# ai_router_model_1_name = "Claude Sonnet 4.6"
# ai_router_model_2_id   = "anthropic.claude-opus-4-7"
# ai_router_model_2_name = "Claude Opus 4.7"
# ai_router_model_3_id   = "global.xai.grok-4.6"
# ai_router_model_3_name = "Grok"
#
# Spend guard is on by default ($25/mo). First two AWS Budgets are free.
# enable_spend_guard                = true
# spend_guard_limit_usd             = 25
# spend_guard_notification_email    = ""
