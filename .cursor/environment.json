{
  "name": "Forge",
  "install": "corepack enable && pnpm install --frozen-lockfile",
  "terminals": [
    {
      "name": "next-dev",
      "command": "pnpm dev"
    },
    {
      "name": "backend-dev",
      "command": "ENVIRONMENT=development FORGE_TEST_USER_ID=test-user-00000000 python3 backend/dev_server.py"
    }
  ],
  "ports": [3000, 3001]
}
